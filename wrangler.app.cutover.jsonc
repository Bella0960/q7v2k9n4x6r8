{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curly-dream-324c",
  "main": "worker-app-cutover.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "MAO_APP_BACKEND",
      "service": "mao"
    }
  ],
  "vars": {
    "MAO_APP_CUTOVER_ENABLED": "false"
  },
  "keep_vars": true
}
