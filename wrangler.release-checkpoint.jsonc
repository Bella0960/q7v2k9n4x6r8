{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maomao-founder-checkpoint-operator",
  "main": "worker/founder-checkpoint-runner.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_CLOUD_DB",
        "class_name": "CloudDatabase",
        "script_name": "mao-auth-preview"
      }
    ]
  },
  "vars": {
    "FOUNDER_TARGET_SCRIPT": "mao-auth-preview",
    "FOUNDER_TARGET_ORIGIN": "https://mao520.com"
  }
}
