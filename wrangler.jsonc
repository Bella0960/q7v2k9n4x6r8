// MAOMAO — Cloudflare Worker（静态资源 + /api 云接口共存）。
// 云能力（推送订阅 / 设备授权 / 执行日志）的部署与密钥说明见 docs/engineering/CLOUD_PUSH.md。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mao",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // 持久化：SQLite-backed Durable Object，随部署自动创建，无需预先 provisioning。
  // 迁移在 worker/migrations/0001_init.js 中版本化，由 DO 首次启动时幂等执行。
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOUD_DB",
        "class_name": "CloudDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CloudDatabase"]
    }
  ],
  // 每日清理过期 / 长期停用的推送订阅。
  "triggers": {
    "crons": ["17 3 * * *"]
  }
