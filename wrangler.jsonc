// Production redeploy trigger for main source commit 4be283839031dae52f5d35026a79b706d58b3337.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mao",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "CLOUD_DB", "class_name": "CloudDatabase" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CloudDatabase"] }
  ],
  "previews": {
    // Branch-specific QA only. Do NOT enable unencrypted person-to-person chat.
    // Production Worker has no social feature flags; this block does not
    // touch app.mao520.com or preview resources from other Git branches.
    "vars": {
      "MAO_SOCIAL_ENABLED": "true",
      "MAO_SOCIAL_CHAT_ENABLED": "false"
    },
    "durable_objects": {
      "bindings": [
        { "name": "CLOUD_DB", "class_name": "CloudDatabase" }
      ]
    }
  }
}
