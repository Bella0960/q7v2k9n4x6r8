// MAOMAO — Cloudflare Worker（静态资源 + /api 云接口共存）；云能力部署与密钥说明见 docs/engineering/CLOUD_PUSH.md。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mao",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Optional Workers AI binding. No inference occurs unless
  // AUTONOMY_MODEL_BACKEND is explicitly set to workers_ai.
  "ai": { "binding": "AI" },
  "vars": {
    "AUTONOMY_MIN_IDLE_MS": "1800000",
    "AUTONOMY_LEASE_MS": "60000",
    "AUTONOMY_TICK_LIMIT": "10",
    "AUTONOMY_RETRY_BACKOFF_MS": "60000,300000,900000,1800000",
    "AUTONOMY_HEARTBEAT_TTL_MS": "90000",
    "AUTONOMY_DEVICE_LEASE_MS": "120000",
    "AUTONOMY_DEVICE_GRACE_MS": "0"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOUD_DB",
        "class_name": "CloudDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CloudDatabase"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "previews": {}
}
