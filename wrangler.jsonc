// Production redeploy trigger for main source commit 4be283839031dae52f5d35026a79b706d58b3337.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mao",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "CLOUD_DB", "class_name": "CloudDatabase" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CloudDatabase"] }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "CLOUD_DB", "class_name": "CloudDatabase" }
      ]
    }
  }
}
