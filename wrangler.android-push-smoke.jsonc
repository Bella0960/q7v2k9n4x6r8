{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "isolated-android-notification-smoke",
  "main": "./qa/android-lockscreen-worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./qa/android-lockscreen-assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_RATE_GATE",
        "class_name": "PushSmokeLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PushSmokeLimiter"
      ]
    }
  ],
  "previews": {
    "vars": {
      "MAO_ANDROID_SMOKE": "true"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "PUSH_RATE_GATE",
          "class_name": "PushSmokeLimiter"
        }
      ]
    }
  },
  "preview_urls": true,
  "routes": [
    {
      "pattern": "notify.mao520.com",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ]
}
